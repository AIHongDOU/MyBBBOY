# ── conda 虚拟环境（体量大，不纳入版本控制） ──────────────
my-ai-companion/env-myboy/

# pip 缓存（体量大，不纳入版本控制）
my-ai-companion/.pipcache/

# 本地模型权重（体量大，不纳入版本控制，由脚本自动下载）
my-ai-companion/models/

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.pytype/
.pyre/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/
.eggs/

# ── 环境变量 / 密钥 ──────────────────────────────────────
.env
.env.*

# ── 日志 / 缓存 / 临时文件 ───────────────────────────────
*.log
*.db
*.sqlite3
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── 前端依赖（体量大，不纳入版本控制） ───────────────────
my-ai-companion/demo/node_modules/

# ── 本地调试探针 / 输出（含测试密钥，绝不提交） ──────────
my-ai-companion/demo/_*